---
# Settings ansible-lint expects from yamllint, per the ansible-lint docs.
extends: default

ignore: |
  res/templates/

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false"]
    # GitHub Actions uses `on:` as a key
    check-keys: false
