---
# Copy to vault.yml (gitignored) and encrypt it:
#   ansible-vault encrypt group_vars/all/vault.yml
#
# SHA-512 crypt hash of the personal admin's sudo password. Generate one with:
#   mkpasswd --method=sha-512        (from the whois package)
vault_admin_password_hash: "$6$examplesalt$replace-with-a-real-hash"
